//  Callback for when a player spawns
stock OnPlayerSpawn(playerid)
{
    IsUsingEnex[playerid] = false; //   Reset the enex usage status
    return 1;
}

public OnFilterScriptExit()
{
    if (wheelTimer != 0)
    {
        KillTimer(wheelTimer);
        wheelTimer = 0;
    }

    DestroyChunderWheelSeats();

    if (IsValidDynamicObject(chunderWheelBody))
    {
        StopDynamicObject(chunderWheelBody);
        DestroyDynamicObject(chunderWheelBody);
        chunderWheelBody = INVALID_STREAMER_ID;
    }

    return 1;
}

public OnGameModeInit()
{
    UpdateVCSNeonsForHour();
    SetTimer("UpdateVCSNeonsForHour", 60000, true);
    return 1;
}
