#include <open.mp> //   Credits to Amir & OMP Team
#include <sscanf2> //  Credits to Y_Less 
#include <streamer> //  Credits to Incognito
#include <zcmd> //  Whatever CMD processor you use

#undef MAX_PLAYERS
#define MAX_PLAYERS 25  //  Whatever is MAX_PLAYERS for your server

#define GetDynamicObjectModel(%0) Streamer_GetIntData(STREAMER_TYPE_OBJECT, %0, E_STREAMER_MODEL_ID)

#define STREAMER_VISIBLEITENS 15000 // How many objects abppear simultaneously for the player.

//  Enex
new Float:entryX = 6149.3047;
new Float:entryY = 2123.7671;
new Float:entryZ = 17.5000;
new entryInterior = 0;

new Float:exitX = 6197.93;
new Float:exitY = 2030.00;
new Float:exitZ = 1225.19;
new exitInterior = 0;

//  Miscellaneous
new entryPickup, exitPickup;
new Float:rotX = 0.0;
new wheel, cage; // MAINWHEEL and attached cage

forward Turn(playerid);
public Turn(playerid)
{
    //  Incremental rotation on the Z-axis for the main wheel?
    rotX += 1.0;
    if (rotX >= 360.0) rotX = 0.0;

    //  Apply rotation to the wheel
    MoveDynamicObject(wheel, 6142.19, 756.77, 32.88, 12.0, rotX, 0.0, 0.0); // MAINWHEEL

    //  Keep the cage straight by applying an exact inverse rotation on the same axis
    MoveDynamicObject(cage, 6142.19, 756.77, 32.88, 12.0, rotX, 0.0, 0.0); //   Counteract rotation

    return 1;
}

public OnPlayerConnect(playerid)
{
    SetTimer("Turn", 80, bool:1);
    PlayerPlaySound(playerid, 6000, 6142.19, 756.77, 32.88);
    return 1;
}

public OnFilterScriptInit()
{
    print("--- Greetings from Vice City(Stories!) Enjoy your stay.");
    
    Streamer_VisibleItems(STREAMER_TYPE_OBJECT, STREAMER_VISIBLEITENS);
    AddVCSModels();
    AddVCSTimedModels();
    CreateDynamicObjects();

    // Create the main wheel
    wheel = CreateDynamicObject(-2514, 6142.19, 756.77, 32.88, rotX, 0.0, 0.0); // MAINWHEEL
    
    // Create the attached cage
    cage = CreateDynamicObject(-2514, 6142.19, 756.77, 32.88, rotX, 0.0, 0.0); // Attached cage with counteracting rotation

    // Create the entry marker
    entryPickup = STREAMER_TAG_PICKUP:CreateDynamicPickup(-2514, 1, entryX, entryY, entryZ, -1, entryInterior, -1, Float:500.0);
    
    // Create the exit marker
    exitPickup = CreateDynamicPickup(-3406, 1, exitX, exitY, exitZ, -1, exitInterior, -1, 1100.0, STREAMER_TAG_AREA:-1, 0);

    printf("Vice City Stories | Total Objects: %d", Streamer_CountItems(STREAMER_TYPE_OBJECT, 0));
    return 1;
}


