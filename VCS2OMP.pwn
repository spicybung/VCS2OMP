new entryPickup, exitPickup;
new entryEnexArea = INVALID_STREAMER_ID, exitEnexArea = INVALID_STREAMER_ID;
new chunderWheelBody = INVALID_STREAMER_ID;
new wheelTimer = 0;
new wheelSeats[12];
new Float:wheelRotX = 0.0;

#define CHUNDER_WHEEL_BODY_MODEL (-2526)
#define CHUNDER_WHEEL_POS_X              (6342.20)
#define CHUNDER_WHEEL_POS_Y              (756.81)
#define CHUNDER_WHEEL_POS_Z              (36.90)
#define CHUNDER_WHEEL_BASE_ROT_X         (0.0)
#define CHUNDER_WHEEL_BASE_ROT_Y         (0.0)
#define CHUNDER_WHEEL_BASE_ROT_Z         (180.0)
#define CHUNDER_WHEEL_TIMER_MS           (50)
#define CHUNDER_WHEEL_ROT_STEP           (0.625)

#define CHUNDER_WHEEL_SEAT_COUNT         (12)
#define CHUNDER_WHEEL_SEAT_MODEL (-2682)
#define CHUNDER_WHEEL_SEAT_POS_X         (6342.21)
#define CHUNDER_WHEEL_SEAT_CENTER_Y      (756.81)
#define CHUNDER_WHEEL_SEAT_CENTER_Z      (36.90)
#define CHUNDER_WHEEL_SEAT_ROT_X         (0.0)
#define CHUNDER_WHEEL_SEAT_ROT_Y         (0.0)
#define CHUNDER_WHEEL_SEAT_ROT_Z         (180.0)

new Float:wheelSeatOffsetY[CHUNDER_WHEEL_SEAT_COUNT] =
{
    0.00,
    -11.58,
    -20.05,
    -23.14,
    -20.04,
    -11.57,
    0.00,
    11.57,
    20.04,
    23.14,
    20.05,
    11.57
};

new Float:wheelSeatOffsetZ[CHUNDER_WHEEL_SEAT_COUNT] =
{
    -23.14,
    -20.05,
    -11.57,
    0.00,
    11.57,
    20.04,
    23.14,
    20.04,
    11.57,
    0.00,
    -11.58,
    -20.05
};

forward TurnChunderWheel();

stock ResetChunderWheelSeatIds()
{
    for (new i = 0; i < CHUNDER_WHEEL_SEAT_COUNT; i++)
    {
        wheelSeats[i] = INVALID_STREAMER_ID;
    }

    return 1;
}

stock DestroyChunderWheelSeats()
{
    for (new i = 0; i < CHUNDER_WHEEL_SEAT_COUNT; i++)
    {
        if (IsValidDynamicObject(wheelSeats[i]))
        {
            DestroyDynamicObject(wheelSeats[i]);
        }

        wheelSeats[i] = INVALID_STREAMER_ID;
    }

    return 1;
}

stock UpdateChunderWheelSeats()
{
    new Float:seatAngle = -wheelRotX;
    new Float:cosAngle = floatcos(seatAngle, degrees);
    new Float:sinAngle = floatsin(seatAngle, degrees);

    for (new i = 0; i < CHUNDER_WHEEL_SEAT_COUNT; i++)
    {
        if (!IsValidDynamicObject(wheelSeats[i]))
        {
            continue;
        }

        new Float:y = CHUNDER_WHEEL_SEAT_CENTER_Y + (wheelSeatOffsetY[i] * cosAngle) - (wheelSeatOffsetZ[i] * sinAngle);
        new Float:z = CHUNDER_WHEEL_SEAT_CENTER_Z + (wheelSeatOffsetY[i] * sinAngle) + (wheelSeatOffsetZ[i] * cosAngle);

        SetDynamicObjectPos(wheelSeats[i], CHUNDER_WHEEL_SEAT_POS_X, y, z);
        SetDynamicObjectRot(wheelSeats[i], CHUNDER_WHEEL_SEAT_ROT_X, CHUNDER_WHEEL_SEAT_ROT_Y, CHUNDER_WHEEL_SEAT_ROT_Z);
    }

    return 1;
}

stock CreateChunderWheelSeats()
{
    DestroyChunderWheelSeats();

    for (new i = 0; i < CHUNDER_WHEEL_SEAT_COUNT; i++)
    {
        wheelSeats[i] = CreateDynamicObject(
            CHUNDER_WHEEL_SEAT_MODEL,
            CHUNDER_WHEEL_SEAT_POS_X,
            CHUNDER_WHEEL_SEAT_CENTER_Y + wheelSeatOffsetY[i],
            CHUNDER_WHEEL_SEAT_CENTER_Z + wheelSeatOffsetZ[i],
            CHUNDER_WHEEL_SEAT_ROT_X,
            CHUNDER_WHEEL_SEAT_ROT_Y,
            CHUNDER_WHEEL_SEAT_ROT_Z,
            -1,
            -1,
            -1,
            1000.00,
            1000.00
        );
    }

    UpdateChunderWheelSeats();
    return 1;
}

stock UpdateChunderWheelBody()
{
    if (!IsValidDynamicObject(chunderWheelBody))
    {
        printf("[VCS2OMP] chunderwheel02 body object is invalid. model=%d object=%d", CHUNDER_WHEEL_BODY_MODEL, chunderWheelBody);
        return 0;
    }

    SetDynamicObjectPos(chunderWheelBody, CHUNDER_WHEEL_POS_X, CHUNDER_WHEEL_POS_Y, CHUNDER_WHEEL_POS_Z);
    SetDynamicObjectRot(chunderWheelBody, wheelRotX, CHUNDER_WHEEL_BASE_ROT_Y, CHUNDER_WHEEL_BASE_ROT_Z);
    return 1;
}

stock StartChunderWheelRotation()
{
    wheelRotX = CHUNDER_WHEEL_BASE_ROT_X;

    UpdateChunderWheelBody();

    CreateChunderWheelSeats();

    if (wheelTimer != 0)
    {
        KillTimer(wheelTimer);
        wheelTimer = 0;
    }

    wheelTimer = SetTimer("TurnChunderWheel", CHUNDER_WHEEL_TIMER_MS, true);
    return 1;
}

public TurnChunderWheel()
{
    wheelRotX += CHUNDER_WHEEL_ROT_STEP;

    if (wheelRotX >= 360.0)
    {
        wheelRotX -= 360.0;
    }

    UpdateChunderWheelBody();
    UpdateChunderWheelSeats();
    return 1;
}

public OnPlayerConnect(playerid)
{
    PlayerPlaySound(playerid, 6000, CHUNDER_WHEEL_POS_X, CHUNDER_WHEEL_POS_Y, CHUNDER_WHEEL_POS_Z);
    return 1;
}

public OnFilterScriptInit()
{
    print("--- Greetings from Vice City(Stories!) Enjoy your stay.");
    
    Streamer_VisibleItems(STREAMER_TYPE_OBJECT, STREAMER_VISIBLEITENS);
    AddVCSModels();
    AddVCSTimedModels();
    CreateDynamicObjects();
    StartChunderWheelRotation();
    CreateDynamicObject(CUSTOM_ENEX_MARKER_MODEL, entryX, entryY, entryZ, 0.0, 0.0, 0.0, entryVirtualWorld, entryInterior, -1, 300.0, 300.0);
    CreateDynamicObject(CUSTOM_ENEX_MARKER_MODEL, exitX, exitY, exitZ, 0.0, 0.0, 0.0, exitVirtualWorld, exitInterior, -1, 300.0, 300.0);

    entryEnexArea = CreateDynamicSphere(entryX, entryY, entryZ, ENEX_AREA_RADIUS, entryVirtualWorld, entryInterior, -1);
    exitEnexArea = CreateDynamicSphere(exitX, exitY, exitZ, ENEX_AREA_RADIUS, exitVirtualWorld, exitInterior, -1);

    printf("Vice City Stories | Total Objects: %d", Streamer_CountItems(STREAMER_TYPE_OBJECT, 0));
    return 1;
}

// Generated by DemonFF
#define VCS_NEON_NIGHT_START (20)
#define VCS_NEON_NIGHT_END (6)
#define MAX_VCS_NEON_OBJECTS (256)

new gVCSNeonObjects[MAX_VCS_NEON_OBJECTS];
new gVCSNeonObjectCount;
new bool:gVCSNeonsVisible;

stock bool:IsVCSNightHour(hour)
{
    return (hour >= VCS_NEON_NIGHT_START || hour < VCS_NEON_NIGHT_END);
}

forward UpdateVCSNeonsForHour();
public UpdateVCSNeonsForHour()
{
    new hour, minute, second;
    gettime(hour, minute, second);

    if (IsVCSNightHour(hour))
    {
        if (!gVCSNeonsVisible)
        {
            CreateVCSNeonObjects();
        }
    }
    else
    {
        if (gVCSNeonsVisible)
        {
            DestroyVCSNeonObjects();
        }
    }

    return 1;
}

stock DestroyVCSNeonObjects()
{
    for (new i = 0; i < gVCSNeonObjectCount; i++)
    {
        if (IsValidDynamicObject(gVCSNeonObjects[i]))
        {
            DestroyDynamicObject(gVCSNeonObjects[i]);
        }

        gVCSNeonObjects[i] = INVALID_STREAMER_ID;
    }

    gVCSNeonObjectCount = 0;
    gVCSNeonsVisible = false;
    return 1;
}

