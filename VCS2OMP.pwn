//  Commands to teleport to places because you or I am lazy
CMD:gotovc(playerid, params[])
{
    SetPlayerVirtualWorld(playerid, 0);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, 6408.59, 1860.29, 59.97);
    return 1;
}


CMD:gotomall(playerid, params[])
{
    SetPlayerVirtualWorld(playerid, MALL_VIRTUAL_WORLD);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, exitX + 1.0, exitY + 5.0, exitZ);
    SetPlayerFacingAngle(playerid, exitAngle);
    return 1;
}

CMD:gokingknutsint(playerid, params[])
{
    SetPlayerVirtualWorld(playerid, KING_KNUTS_INTERIOR_VIRTUAL_WORLD);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, 4953.56, 1082.28, 1002.00);
    SetPlayerFacingAngle(playerid, 180.0);
    return 1;
}

CMD:gostripint(playerid, params[])
{
    SetPlayerVirtualWorld(playerid, STRIP_CLUB_INTERIOR_VIRTUAL_WORLD);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, 6084.65, -462.57, 1013.00);
    SetPlayerFacingAngle(playerid, 180.0);
    return 1;
}

CMD:gobarracksint(playerid, params[])
{
    SetPlayerVirtualWorld(playerid, BARRACKS_INTERIOR_VIRTUAL_WORLD);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, 4351.11, 719.19, 19.00);
    SetPlayerFacingAngle(playerid, 180.0);
    return 1;
}

CMD:gojerryint(playerid, params[])
{
    SetPlayerVirtualWorld(playerid, JERRY_INTERIOR_VIRTUAL_WORLD);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, 4395.40, 877.19, 19.00);
    SetPlayerFacingAngle(playerid, 180.0);
    return 1;
}

CMD:goammuinterior(playerid, params[])
{
    SetPlayerVirtualWorld(playerid, AMMUNATION_INTERIOR_VIRTUAL_WORLD);
    SetPlayerInterior(playerid, 0);
    SetPlayerPos(playerid, 5323.20, 2205.12, 15.00);
    SetPlayerFacingAngle(playerid, 180.0);
    return 1;
}

//  Command for making it day time
CMD:day(playerid, params[])
{
	SetWorldTime(12);
	return 1;
}

//  Command for making it night time
CMD:night(playerid, params[])
{
	SetWorldTime(0);
	return 1;
}


stock SendPlayerToMallEnexExit(playerid)
{
    SetPlayerVirtualWorld(playerid, exitVirtualWorld);
    SetPlayerInterior(playerid, exitInterior);
    SetPlayerPos(playerid, exitX + 1.0, exitY + 5.0, exitZ);
    SetPlayerFacingAngle(playerid, exitAngle);
    IsUsingEnex[playerid] = true;
    return 1;
}

stock SendPlayerToCustomEntryEnex(playerid)
{
    SetPlayerVirtualWorld(playerid, entryVirtualWorld);
    SetPlayerInterior(playerid, entryInterior);
    SetPlayerPos(playerid, entryX + 1.0, entryY + 5.0, entryZ);
    SetPlayerFacingAngle(playerid, entryAngle);
    IsUsingEnex[playerid] = true;
    return 1;
}

stock OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if (pickupid == entryPickup)
    {
        return SendPlayerToMallEnexExit(playerid);
    }
    else if (pickupid == exitPickup)
    {
        return SendPlayerToCustomEntryEnex(playerid);
    }
    return 0;
}


public OnPlayerEnterDynamicArea(playerid, areaid)
{
    if (areaid == entryEnexArea)
    {
        return SendPlayerToMallEnexExit(playerid);
    }
    else if (areaid == exitEnexArea)
    {
        return SendPlayerToCustomEntryEnex(playerid);
    }

    return 1;
}

