//  Command to teleport to Vice City
CMD:gotovc(playerid, params[])
{
	SetPlayerPos(playerid, 6408.59, 1860.29, 59.97);
	return 1;
}

//  Command for selecting an object, kinda buggy.
CMD:select(playerid, params[])
{
	BeginObjectSelecting(playerid);
	return 1;
}

//  Command for making it day time
CMD:day(playerid, params[])
{
	SetWorldTime(12);
	return 1;
}

//  Command for making it night time
CMD:night(playerid, params[])
{
	SetWorldTime(0);
	return 1;
}

stock OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if (pickupid == entryPickup)
    {
        //  Set player's interior and position to the exit point & offset
        SetPlayerInterior(playerid, exitInterior);
        SetPlayerPos(playerid, exitX + 1.0, exitY + 5.0, exitZ); // Add an offset
        SetPlayerFacingAngle(playerid, exitAngle);
        IsUsingEnex[playerid] = true; //    Indicate the player used the enex
        return 1;
    }
    else if (pickupid == exitPickup)
    {
        // Set player's interior and position to the entry point with an offset
        SetPlayerInterior(playerid, entryInterior);
        SetPlayerPos(playerid, entryX + 1.0, entryY + 5.0, entryZ); // Add an offset
        SetPlayerFacingAngle(playerid, 0.0); // Adjust as needed
        IsUsingEnex[playerid] = true; // Indicate that the player used the enex
        return 1;
    }
    return 0;
}

//  Command for going to x y z because you or I am lazy
CMD:xgoto(playerid, params[])
{
    new Float:x, Float:y, Float:z;

    if(sscanf(params, "fff", x, y, z))
    {
        SendClientMessage(playerid, 0xFF0000FF, "Usage: /xgoto [x] [y] [z]");
        return 1;
    }

    SetPlayerPos(playerid, x, y, z);

    SendClientMessage(playerid, 0x00FF00FF, "Teleported to specified coordinates.");

    return 1;
}

//  Callback for when a player spawns
stock OnPlayerSpawn(playerid)
{
    IsUsingEnex[playerid] = false; //   Reset the enex usage status
    return 1;
}

public OnFilterScriptExit() {
    
	return true;
}
