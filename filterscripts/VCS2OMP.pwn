stock OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if (pickupid == entryPickup)
    {
        //  Set player's interior and position to the exit point & offset
        SetPlayerInterior(playerid, exitInterior);
        SetPlayerPos(playerid, exitX + 1.0, exitY + 5.0, exitZ); // Add an offset
        SetPlayerFacingAngle(playerid, exitAngle);
        IsUsingEnex[playerid] = true; //    Indicate the player used the enex
        return 1;
    }
    else if (pickupid == exitPickup)
    {
        // Set player's interior and position to the entry point with an offset
        SetPlayerInterior(playerid, entryInterior);
        SetPlayerPos(playerid, entryX + 1.0, entryY + 5.0, entryZ); // Add an offset
        SetPlayerFacingAngle(playerid, 0.0); // Adjust as needed
        IsUsingEnex[playerid] = true; // Indicate that the player used the enex
        return 1;
    }
    return 0;
}

