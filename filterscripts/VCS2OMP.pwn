public OnPlayerEnterDynamicArea(playerid, STREAMER_TAG_AREA:areaid)
{
    if (!VCSEnexAreasReady || !IsValidDynamicArea(areaid) ||
        !IsPlayerConnected(playerid) || IsPlayerNPC(playerid) ||
        GetPlayerState(playerid) != PLAYER_STATE_ONFOOT ||
        GetPlayerVirtualWorld(playerid) != VCS_ENEX_VIRTUAL_WORLD ||
        GetPlayerInterior(playerid) != VCS_ENEX_SA_INTERIOR)
    {
        return 0;
    }
    new route = FindVCSEnexRoute(playerid, areaid);
    if (route < 0 || !IsPlayerAtVCSEnexTrigger(playerid, route))
    {
        return 0;
    }
    RefreshVCSEnexArrivalBlocks(playerid);
    if (VCSEnexHasArrivalBlock(playerid))
    {
        return 0;
    }
    new currentTick = GetTickCount();
    new elapsed = currentTick - VCSEnexLastUseTick[playerid];
    if (VCSEnexCooldownActive[playerid] && elapsed >= 0 && elapsed < VCS_ENEX_COOLDOWN_MS)
    {
        return 0;
    }
    new previousSourceArea = VCSEnexPlayerSourceArea[playerid];
    new previousReturnPair = VCSEnexReturnPair[playerid];
    new previousUseTick = VCSEnexLastUseTick[playerid];
    new bool:previousCooldown = VCSEnexCooldownActive[playerid];
    VCSEnexLastUseTick[playerid] = currentTick;
    VCSEnexCooldownActive[playerid] = true;

    new returnPair = VCSEnexRoutes[route][VCS_ENEX_IS_RETURN] ? -1 : VCSEnexRoutes[route][VCS_ENEX_PAIR];
    SetVCSEnexLogicalState(playerid, VCSEnexRoutes[route][VCS_ENEX_DEST_AREA], returnPair);
    new Float:x = VCSEnexRoutes[route][VCS_ENEX_DEST_X] + VCS_WORLD_OFFSET_X;
    new Float:y = VCSEnexRoutes[route][VCS_ENEX_DEST_Y] + VCS_WORLD_OFFSET_Y;
    new Float:z = VCSEnexRoutes[route][VCS_ENEX_DEST_Z] + 1.0;
    BlockVCSEnexDestination(playerid, route, x, y, z);
    if (!Streamer_UpdateEx(playerid, x, y, z, VCS_ENEX_VIRTUAL_WORLD,
        VCS_ENEX_SA_INTERIOR, STREAMER_TYPE_OBJECT, -1, 0))
    {
        SetVCSEnexLogicalState(playerid, previousSourceArea, previousReturnPair);
        ClearVCSEnexArrivalState(playerid);
        VCSEnexLastUseTick[playerid] = previousUseTick;
        VCSEnexCooldownActive[playerid] = previousCooldown;
        printf("[VCS2OMP] ERROR: ENEX route %d destination streaming failed for player %d; player remains at source.", route, playerid);
        return 0;
    }
    SetPlayerInterior(playerid, VCS_ENEX_SA_INTERIOR);
    SetPlayerPos(playerid, x, y, z);
    SetPlayerFacingAngle(playerid, VCSEnexRoutes[route][VCS_ENEX_DEST_ANGLE]);
    return 1;
}

public OnPlayerLeaveDynamicArea(playerid, STREAMER_TAG_AREA:areaid)
{
    if (!VCSEnexAreasReady || !IsValidDynamicArea(areaid) || !IsPlayerConnected(playerid) ||
        GetPlayerVirtualWorld(playerid) != VCS_ENEX_VIRTUAL_WORLD ||
        GetPlayerInterior(playerid) != VCS_ENEX_SA_INTERIOR)
    {
        return 0;
    }
    new bool:departed;
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (VCSEnexAreas[route] != areaid || !VCSEnexArrivalBlocked[playerid][route] ||
            VCSEnexRoutes[route][VCS_ENEX_SOURCE_AREA] != VCSEnexPlayerSourceArea[playerid])
        {
            continue;
        }
        if (IsPlayerAtVCSEnexTrigger(playerid, route))
        {
            return 0;
        }
        VCSEnexArrivalBlocked[playerid][route] = false;
        departed = true;
    }
    if (departed && !VCSEnexHasArrivalBlock(playerid))
    {
        ClearVCSEnexArrivalState(playerid);
    }
    return departed ? 1 : 0;
}

public OnPlayerUpdate(playerid)
{
    if (VCSEnexAreasReady && IsPlayerConnected(playerid) && VCSEnexArrivalActive[playerid] &&
        GetPlayerVirtualWorld(playerid) == VCS_ENEX_VIRTUAL_WORLD &&
        GetPlayerInterior(playerid) == VCS_ENEX_SA_INTERIOR)
    {
        RefreshVCSEnexArrivalBlocks(playerid);
    }
    return 1;
}

