//  Callback for when a player spawns
stock OnPlayerSpawn(playerid)
{
    IsUsingEnex[playerid] = false; //   Reset the enex usage status
    return 1;
}

public OnFilterScriptExit()
{
    if (wheelTimer != 0)
    {
        KillTimer(wheelTimer);
        wheelTimer = 0;
    }

    if (IsValidDynamicObject(wheel))
    {
        StopDynamicObject(wheel);
        DestroyDynamicObject(wheel);
        wheel = INVALID_STREAMER_ID;
    }

    if (lighthouseBeaconTimer != 0)
    {
        KillTimer(lighthouseBeaconTimer);
        lighthouseBeaconTimer = 0;
    }

    if (IsValidDynamicObject(lighthouseBeacon))
    {
        StopDynamicObject(lighthouseBeacon);
        DestroyDynamicObject(lighthouseBeacon);
        lighthouseBeacon = INVALID_STREAMER_ID;
    }

    return 1;
}
