#define GetDynamicObjectModel(%0) Streamer_GetIntData(STREAMER_TYPE_OBJECT, %0, E_STREAMER_MODEL_ID)

#define STREAMER_VISIBLEITENS 15000 // How many objects abppear simultaneously for the player.

#if !defined INVALID_STREAMER_ID
    #define INVALID_STREAMER_ID (0)
#endif

//  Enex
new Float:entryX = 6149.3047;
new Float:entryY = 2123.7671;
new Float:entryZ = 17.5000;
new entryInterior = 0;

new Float:exitX = 6197.93;
new Float:exitY = 2030.00;
new Float:exitZ = 1225.19;
new exitInterior = 0;
new Float:exitAngle = 0.0;
new bool:IsUsingEnex[MAX_PLAYERS];

//  Miscellaneous
new entryPickup, exitPickup;
new wheel = INVALID_STREAMER_ID;
new wheelTimer = 0;
new Float:wheelRotX = 0.0;

new lighthouseBeacon = INVALID_STREAMER_ID;
new lighthouseBeaconTimer = 0;
new Float:lighthouseBeaconRotY = 0.0;

#define CHUNDER_WHEEL_POS_X              (6342.20)
#define CHUNDER_WHEEL_POS_Y              (1756.81)
#define CHUNDER_WHEEL_POS_Z              (36.90)
#define CHUNDER_WHEEL_BASE_ROT_X         (0.0)
#define CHUNDER_WHEEL_BASE_ROT_Y         (0.0)
#define CHUNDER_WHEEL_BASE_ROT_Z         (180.0)
#define CHUNDER_WHEEL_TIMER_MS           (50)
#define CHUNDER_WHEEL_ROT_STEP           (0.625)

#define LIGHTHOUSE_BEACON_POS_X          (6643.05)
#define LIGHTHOUSE_BEACON_POS_Y          (282.33)
#define LIGHTHOUSE_BEACON_POS_Z          (60.09)
#define LIGHTHOUSE_BEACON_BASE_ROT_X     (-90.0)
#define LIGHTHOUSE_BEACON_BASE_ROT_Y     (0.0)
#define LIGHTHOUSE_BEACON_BASE_ROT_Z     (-90.0)
#define LIGHTHOUSE_BEACON_TIMER_MS       (50)
#define LIGHTHOUSE_BEACON_ROT_STEP       (0.25)

forward TurnChunderWheel();
forward TurnLighthouseBeacon();

stock StartChunderWheelRotation()
{
    if (!IsValidDynamicObject(wheel))
    {
        return 0;
    }

    wheelRotX = CHUNDER_WHEEL_BASE_ROT_X;

    StopDynamicObject(wheel);
    SetDynamicObjectPos(wheel, CHUNDER_WHEEL_POS_X, CHUNDER_WHEEL_POS_Y, CHUNDER_WHEEL_POS_Z);
    SetDynamicObjectRot(wheel, CHUNDER_WHEEL_BASE_ROT_X, CHUNDER_WHEEL_BASE_ROT_Y, CHUNDER_WHEEL_BASE_ROT_Z);

    if (wheelTimer != 0)
    {
        KillTimer(wheelTimer);
        wheelTimer = 0;
    }

    wheelTimer = SetTimer("TurnChunderWheel", CHUNDER_WHEEL_TIMER_MS, true);
    return 1;
}

public TurnChunderWheel()
{
    if (!IsValidDynamicObject(wheel))
    {
        return 0;
    }

    wheelRotX += CHUNDER_WHEEL_ROT_STEP;

    if (wheelRotX >= 360.0)
    {
        wheelRotX -= 360.0;
    }

    SetDynamicObjectPos(wheel, CHUNDER_WHEEL_POS_X, CHUNDER_WHEEL_POS_Y, CHUNDER_WHEEL_POS_Z);
    SetDynamicObjectRot(wheel, wheelRotX, CHUNDER_WHEEL_BASE_ROT_Y, CHUNDER_WHEEL_BASE_ROT_Z);
    return 1;
}

stock StartLighthouseBeaconRotation()
{
    if (!IsValidDynamicObject(lighthouseBeacon))
    {
        return 0;
    }

    lighthouseBeaconRotY = LIGHTHOUSE_BEACON_BASE_ROT_Y;

    StopDynamicObject(lighthouseBeacon);
    SetDynamicObjectPos(
        lighthouseBeacon,
        LIGHTHOUSE_BEACON_POS_X,
        LIGHTHOUSE_BEACON_POS_Y,
        LIGHTHOUSE_BEACON_POS_Z
    );
    SetDynamicObjectRot(
        lighthouseBeacon,
        LIGHTHOUSE_BEACON_BASE_ROT_X,
        LIGHTHOUSE_BEACON_BASE_ROT_Y,
        LIGHTHOUSE_BEACON_BASE_ROT_Z
    );

    if (lighthouseBeaconTimer != 0)
    {
        KillTimer(lighthouseBeaconTimer);
        lighthouseBeaconTimer = 0;
    }

    lighthouseBeaconTimer = SetTimer(
        "TurnLighthouseBeacon",
        LIGHTHOUSE_BEACON_TIMER_MS,
        true
    );
    return 1;
}

public TurnLighthouseBeacon()
{
    if (!IsValidDynamicObject(lighthouseBeacon))
    {
        return 0;
    }

    lighthouseBeaconRotY += LIGHTHOUSE_BEACON_ROT_STEP;

    if (lighthouseBeaconRotY >= 360.0)
    {
        lighthouseBeaconRotY -= 360.0;
    }

    SetDynamicObjectRot(
        lighthouseBeacon,
        LIGHTHOUSE_BEACON_BASE_ROT_X,
        lighthouseBeaconRotY,
        LIGHTHOUSE_BEACON_BASE_ROT_Z
    );
    return 1;
}

public OnPlayerConnect(playerid)
{
    PlayerPlaySound(playerid, 6000, CHUNDER_WHEEL_POS_X, CHUNDER_WHEEL_POS_Y, CHUNDER_WHEEL_POS_Z);
    return 1;
}

public OnFilterScriptInit()
{
    print("--- Greetings from Vice City(Stories!) Enjoy your stay.");
    
    Streamer_VisibleItems(STREAMER_TYPE_OBJECT, STREAMER_VISIBLEITENS);
    AddVCSModels();
    AddVCSTimedModels();
    CreateDynamicObjects();
    StartChunderWheelRotation();
    StartLighthouseBeaconRotation();

    entryPickup = STREAMER_TAG_PICKUP:CreateDynamicPickup(-2514, 1, entryX, entryY, entryZ, -1, entryInterior, -1, Float:500.0);
    exitPickup = CreateDynamicPickup(-3406, 1, exitX, exitY, exitZ, -1, exitInterior, -1, 1100.0, STREAMER_TAG_AREA:-1, 0);

    printf("Vice City Stories | Total Objects: %d", Streamer_CountItems(STREAMER_TYPE_OBJECT, 0));
    return 1;
}

