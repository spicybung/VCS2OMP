stock ClearVCSEnexArrivalState(playerid)
{
    VCSEnexArrivalActive[playerid] = false;
    VCSEnexArrivalObserved[playerid] = false;
    VCSEnexArrivalSourceRoute[playerid] = -1;
    VCSEnexCooldownActive[playerid] = false;
    VCSEnexLastUseTick[playerid] = 0;
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        VCSEnexArrivalBlocked[playerid][route] = false;
    }
    return 1;
}

stock SetVCSEnexLogicalState(playerid, sourceArea, returnPair)
{
    VCSEnexPlayerSourceArea[playerid] = sourceArea;
    VCSEnexReturnPair[playerid] = returnPair;
    IsUsingEnex[playerid] = sourceArea != 0;
    if (sourceArea != 0)
    {
        SetPVarInt(playerid, VCS_RADAR_INTERIOR_PVAR, 1);
    }
    else
    {
        DeletePVar(playerid, VCS_RADAR_INTERIOR_PVAR);
    }
    if (returnPair >= 0)
    {
        SetPVarInt(playerid, VCS_ENEX_SOURCE_AREA_PVAR, sourceArea);
        SetPVarInt(playerid, VCS_ENEX_RETURN_PAIR_PVAR, returnPair + 1);
    }
    else
    {
        DeletePVar(playerid, VCS_ENEX_SOURCE_AREA_PVAR);
        DeletePVar(playerid, VCS_ENEX_RETURN_PAIR_PVAR);
    }
    UpdateVCSEnexMarkersForPlayer(playerid);
    return 1;
}

stock ResetVCSEnexPlayerState(playerid)
{
    ClearVCSEnexArrivalState(playerid);
    SetVCSEnexLogicalState(playerid, 0, -1);
    return 1;
}

stock RestoreVCSEnexPlayerState(playerid)
{
    ClearVCSEnexArrivalState(playerid);
    new sourceArea = GetPVarInt(playerid, VCS_ENEX_SOURCE_AREA_PVAR);
    new returnPair = GetPVarInt(playerid, VCS_ENEX_RETURN_PAIR_PVAR) - 1;
    if (returnPair < 0 || returnPair >= VCS_ENEX_PAIR_COUNT ||
        GetPlayerVirtualWorld(playerid) != VCS_ENEX_VIRTUAL_WORLD ||
        GetPlayerInterior(playerid) != VCS_ENEX_SA_INTERIOR)
    {
        return ResetVCSEnexPlayerState(playerid);
    }
    new returnRoute = returnPair * 2 + 1;
    if (sourceArea != VCSEnexRoutes[returnRoute][VCS_ENEX_SOURCE_AREA])
    {
        return ResetVCSEnexPlayerState(playerid);
    }
    return SetVCSEnexLogicalState(playerid, sourceArea, returnPair);
}

stock bool:IsPlayerAtVCSEnexTrigger(playerid, route)
{
    return IsPlayerInRangeOfPoint(playerid, VCS_ENEX_TRIGGER_RADIUS,
        VCSEnexRoutes[route][VCS_ENEX_TRIGGER_X] + VCS_WORLD_OFFSET_X,
        VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Y] + VCS_WORLD_OFFSET_Y,
        VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Z] + 1.0);
}

stock bool:VCSEnexHasArrivalBlock(playerid)
{
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (VCSEnexArrivalBlocked[playerid][route])
        {
            return true;
        }
    }
    return false;
}

stock BlockVCSEnexDestination(playerid, sourceRoute, Float:x, Float:y, Float:z)
{
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        new Float:dx = x - (VCSEnexRoutes[route][VCS_ENEX_TRIGGER_X] + VCS_WORLD_OFFSET_X);
        new Float:dy = y - (VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Y] + VCS_WORLD_OFFSET_Y);
        new Float:dz = z - (VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Z] + 1.0);
        VCSEnexArrivalBlocked[playerid][route] =
            VCSEnexRoutes[route][VCS_ENEX_SOURCE_AREA] == VCSEnexPlayerSourceArea[playerid] &&
            dx * dx + dy * dy + dz * dz <= VCS_ENEX_TRIGGER_RADIUS * VCS_ENEX_TRIGGER_RADIUS;
    }
    VCSEnexArrivalActive[playerid] = VCSEnexHasArrivalBlock(playerid);
    VCSEnexArrivalObserved[playerid] = false;
    VCSEnexArrivalSourceRoute[playerid] = sourceRoute;
    if (!VCSEnexArrivalActive[playerid])
    {
        ClearVCSEnexArrivalState(playerid);
    }
    return 1;
}

stock RestoreVCSEnexArrivalBlocks(playerid)
{
    ClearVCSEnexArrivalState(playerid);
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        VCSEnexArrivalBlocked[playerid][route] =
            VCSEnexRoutes[route][VCS_ENEX_SOURCE_AREA] == VCSEnexPlayerSourceArea[playerid] &&
            IsPlayerAtVCSEnexTrigger(playerid, route);
    }
    VCSEnexArrivalActive[playerid] = VCSEnexHasArrivalBlock(playerid);
    return 1;
}

stock RefreshVCSEnexArrivalBlocks(playerid)
{
    if (!VCSEnexArrivalActive[playerid])
    {
        return 0;
    }
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (VCSEnexArrivalBlocked[playerid][route] && IsPlayerAtVCSEnexTrigger(playerid, route))
        {
            VCSEnexArrivalObserved[playerid] = true;
            break;
        }
    }
    new sourceRoute = VCSEnexArrivalSourceRoute[playerid];
    new elapsed = GetTickCount() - VCSEnexLastUseTick[playerid];
    if (!VCSEnexArrivalObserved[playerid] && sourceRoute >= 0 &&
        elapsed >= 0 && elapsed < VCS_ENEX_COOLDOWN_MS && IsPlayerAtVCSEnexTrigger(playerid, sourceRoute))
    {
        return 0;
    }
    new bool:departed;
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (VCSEnexArrivalBlocked[playerid][route] && !IsPlayerAtVCSEnexTrigger(playerid, route))
        {
            VCSEnexArrivalBlocked[playerid][route] = false;
            departed = true;
        }
    }
    if (!VCSEnexHasArrivalBlock(playerid))
    {
        ClearVCSEnexArrivalState(playerid);
    }
    return departed ? 1 : 0;
}

stock UpdateVCSEnexMarkersForPlayer(playerid)
{
    if (!VCSEnexAreasReady || !IsPlayerConnected(playerid))
    {
        return 0;
    }
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (!VCSEnexOwnsArea[route] || !IsValidDynamicObject(VCSEnexMarkers[route]))
        {
            continue;
        }
        Streamer_ToggleItem(playerid, STREAMER_TYPE_OBJECT, VCSEnexMarkers[route],
            VCSEnexRoutes[route][VCS_ENEX_SOURCE_AREA] == VCSEnexPlayerSourceArea[playerid]);
    }
    return 1;
}

stock bool:CreateVCSEnexMarkers()
{
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (!VCSEnexOwnsArea[route])
        {
            for (new previous = 0; previous < route; previous++)
            {
                if (VCSEnexAreas[previous] == VCSEnexAreas[route])
                {
                    VCSEnexMarkers[route] = VCSEnexMarkers[previous];
                    break;
                }
            }
            continue;
        }
        VCSEnexMarkers[route] = CreateDynamicObject(
            VCS_ENEX_MARKER_MODEL,
            VCSEnexRoutes[route][VCS_ENEX_TRIGGER_X] + VCS_WORLD_OFFSET_X,
            VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Y] + VCS_WORLD_OFFSET_Y,
            VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Z] + 1.0 + VCS_ENEX_MARKER_Z_OFFSET,
            0.0, 0.0, 0.0,
            VCS_ENEX_VIRTUAL_WORLD, VCS_ENEX_SA_INTERIOR, -1,
            VCS_ENEX_MARKER_STREAM_DISTANCE, VCS_ENEX_MARKER_DRAW_DISTANCE,
            STREAMER_TAG_AREA:-1, VCS_ENEX_MARKER_PRIORITY);
        if (!IsValidDynamicObject(VCSEnexMarkers[route]))
        {
            printf("[VCS2OMP] ERROR: ENEX route %d marker creation failed; entrance creation is rolled back.", route);
            return false;
        }
    }
    return true;
}

stock DestroyVCSEnexAreas()
{
    VCSEnexAreasReady = false;
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (VCSEnexOwnsArea[route] && IsValidDynamicObject(VCSEnexMarkers[route]))
        {
            DestroyDynamicObject(VCSEnexMarkers[route]);
        }
        if (VCSEnexOwnsArea[route] && IsValidDynamicArea(VCSEnexAreas[route]))
        {
            DestroyDynamicArea(VCSEnexAreas[route]);
        }
    }
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        VCSEnexAreas[route] = STREAMER_TAG_AREA:INVALID_STREAMER_ID;
        VCSEnexMarkers[route] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
        VCSEnexOwnsArea[route] = false;
    }
    for (new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        ClearVCSEnexArrivalState(playerid);
    }
    return 1;
}

stock bool:CreateVCSEnexAreas()
{
    DestroyVCSEnexAreas();
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        new sharedRoute = -1;
        for (new previous = 0; previous < route; previous++)
        {
            if (VCSEnexRoutes[previous][VCS_ENEX_SOURCE_AREA] == VCSEnexRoutes[route][VCS_ENEX_SOURCE_AREA] &&
                VCSEnexRoutes[previous][VCS_ENEX_TRIGGER_X] == VCSEnexRoutes[route][VCS_ENEX_TRIGGER_X] &&
                VCSEnexRoutes[previous][VCS_ENEX_TRIGGER_Y] == VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Y] &&
                VCSEnexRoutes[previous][VCS_ENEX_TRIGGER_Z] == VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Z])
            {
                sharedRoute = previous;
                break;
            }
        }
        if (sharedRoute >= 0)
        {
            VCSEnexAreas[route] = VCSEnexAreas[sharedRoute];
            continue;
        }
        VCSEnexAreas[route] = CreateDynamicSphere(
            VCSEnexRoutes[route][VCS_ENEX_TRIGGER_X] + VCS_WORLD_OFFSET_X,
            VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Y] + VCS_WORLD_OFFSET_Y,
            VCSEnexRoutes[route][VCS_ENEX_TRIGGER_Z] + 1.0,
            VCS_ENEX_TRIGGER_RADIUS, VCS_ENEX_VIRTUAL_WORLD, VCS_ENEX_SA_INTERIOR);
        if (!IsValidDynamicArea(VCSEnexAreas[route]))
        {
            DestroyVCSEnexAreas();
            printf("[VCS2OMP] ERROR: ENEX route %d area creation failed; all entrances are disabled.", route);
            return false;
        }
        VCSEnexOwnsArea[route] = true;
    }
    if (!CreateVCSEnexMarkers())
    {
        DestroyVCSEnexAreas();
        return false;
    }
    VCSEnexAreasReady = true;
    for (new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if (IsPlayerConnected(playerid))
        {
            RestoreVCSEnexArrivalBlocks(playerid);
            UpdateVCSEnexMarkersForPlayer(playerid);
        }
    }
    return true;
}

stock FindVCSEnexRoute(playerid, STREAMER_TAG_AREA:areaid)
{
    new candidate = -1;
    for (new route = 0; route < VCS_ENEX_ROUTE_COUNT; route++)
    {
        if (VCSEnexAreas[route] != areaid ||
            VCSEnexRoutes[route][VCS_ENEX_SOURCE_AREA] != VCSEnexPlayerSourceArea[playerid])
        {
            continue;
        }
        if (candidate == -1)
        {
            candidate = route;
        }
        if (VCSEnexRoutes[route][VCS_ENEX_IS_RETURN] &&
            VCSEnexRoutes[route][VCS_ENEX_PAIR] == VCSEnexReturnPair[playerid])
        {
            return route;
        }
    }
    // Shared mall exit: default to MALL1.
    return candidate;
}

forward TurnChunderWheel();
forward TurnLighthouseBeacon();

stock StartChunderWheelRotation()
{
    if (!IsValidDynamicObject(wheel))
    {
        return 0;
    }

    wheelRotX = CHUNDER_WHEEL_BASE_ROT_X;

    StopDynamicObject(wheel);
    SetDynamicObjectPos(wheel, CHUNDER_WHEEL_POS_X, CHUNDER_WHEEL_POS_Y, CHUNDER_WHEEL_POS_Z);
    SetDynamicObjectRot(wheel, CHUNDER_WHEEL_BASE_ROT_X, CHUNDER_WHEEL_BASE_ROT_Y, CHUNDER_WHEEL_BASE_ROT_Z);

    if (wheelTimer != 0)
    {
        KillTimer(wheelTimer);
        wheelTimer = 0;
    }

    wheelTimer = SetTimer("TurnChunderWheel", CHUNDER_WHEEL_TIMER_MS, true);
    return 1;
}

public TurnChunderWheel()
{
    if (!IsValidDynamicObject(wheel))
    {
        return 0;
    }

    wheelRotX += CHUNDER_WHEEL_ROT_STEP;

    if (wheelRotX >= 360.0)
    {
        wheelRotX -= 360.0;
    }

    SetDynamicObjectRot(wheel, wheelRotX, CHUNDER_WHEEL_BASE_ROT_Y, CHUNDER_WHEEL_BASE_ROT_Z);
    return 1;
}

stock StartLighthouseBeaconRotation()
{
    if (!IsValidDynamicObject(lighthouseBeacon))
    {
        return 0;
    }

    lighthouseBeaconRotY = LIGHTHOUSE_BEACON_BASE_ROT_Y;

    StopDynamicObject(lighthouseBeacon);
    SetDynamicObjectPos(
        lighthouseBeacon,
        LIGHTHOUSE_BEACON_POS_X,
        LIGHTHOUSE_BEACON_POS_Y,
        LIGHTHOUSE_BEACON_POS_Z
    );
    SetDynamicObjectRot(
        lighthouseBeacon,
        LIGHTHOUSE_BEACON_BASE_ROT_X,
        LIGHTHOUSE_BEACON_BASE_ROT_Y,
        LIGHTHOUSE_BEACON_BASE_ROT_Z
    );

    if (lighthouseBeaconTimer != 0)
    {
        KillTimer(lighthouseBeaconTimer);
        lighthouseBeaconTimer = 0;
    }

    lighthouseBeaconTimer = SetTimer(
        "TurnLighthouseBeacon",
        LIGHTHOUSE_BEACON_TIMER_MS,
        true
    );
    return 1;
}

public TurnLighthouseBeacon()
{
    if (!IsValidDynamicObject(lighthouseBeacon))
    {
        return 0;
    }

    lighthouseBeaconRotY += LIGHTHOUSE_BEACON_ROT_STEP;

    if (lighthouseBeaconRotY >= 360.0)
    {
        lighthouseBeaconRotY -= 360.0;
    }

    SetDynamicObjectRot(
        lighthouseBeacon,
        LIGHTHOUSE_BEACON_BASE_ROT_X,
        lighthouseBeaconRotY,
        LIGHTHOUSE_BEACON_BASE_ROT_Z
    );
    return 1;
}

public OnPlayerConnect(playerid)
{
    ResetVCSEnexPlayerState(playerid);
    PlayerPlaySound(playerid, 6000, CHUNDER_WHEEL_POS_X, CHUNDER_WHEEL_POS_Y, CHUNDER_WHEEL_POS_Z);
    return 1;
}

public OnFilterScriptInit()
{
    for (new playerid = 0; playerid < MAX_PLAYERS; playerid++)
    {
        if (IsPlayerConnected(playerid))
        {
            RestoreVCSEnexPlayerState(playerid);
        }
    }

    Streamer_VisibleItems(STREAMER_TYPE_OBJECT, STREAMER_VISIBLEITENS);
    AddVCSModels();
    AddVCSTimedModels();
    CreateDynamicObjects();
    StartChunderWheelRotation();
    StartLighthouseBeaconRotation();

    CreateVCSEnexAreas();

    printf("Vice City Stories | Total Objects: %d", Streamer_CountItems(STREAMER_TYPE_OBJECT, 0));
    return 1;
}

