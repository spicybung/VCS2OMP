stock STREAMER_TAG_OBJECT:VCSCreateDynamicObject(
    modelid,
    Float:x,
    Float:y,
    Float:z,
    Float:rx,
    Float:ry,
    Float:rz,
    worldid = -1,
    interiorid = -1,
    playerid = -1,
    Float:streamdistance = STREAMER_OBJECT_SD,
    Float:drawdistance = STREAMER_OBJECT_DD,
    STREAMER_TAG_AREA:areaid = STREAMER_TAG_AREA:-1,
    priority = 0
)
{
    return CreateDynamicObject(
        modelid,
        VCS_WORLD_X(x),
        VCS_WORLD_Y(y),
        z,
        rx,
        ry,
        rz,
        worldid,
        interiorid,
        playerid,
        streamdistance,
        drawdistance,
        areaid,
        priority
    );
}

